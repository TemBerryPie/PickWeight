<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.GroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="12,16,12,24" />
                        <Setter Target="GroupsColumn.Width" Value="*" />
                        <Setter Target="DetailsColumn.Width" Value="0" />
                        <Setter Target="GroupListPanel.(Grid.Row)" Value="0" />
                        <Setter Target="GroupListPanel.(Grid.Column)" Value="0" />
                        <Setter Target="GroupListPanel.(Grid.RowSpan)" Value="1" />
                        <Setter Target="DetailsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="DetailsPanel.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="20,24" />
                        <Setter Target="GroupsColumn.Width" Value="260" />
                        <Setter Target="DetailsColumn.Width" Value="*" />
                        <Setter Target="GroupListPanel.(Grid.Row)" Value="0" />
                        <Setter Target="GroupListPanel.(Grid.Column)" Value="0" />
                        <Setter Target="GroupListPanel.(Grid.RowSpan)" Value="2" />
                        <Setter Target="DetailsPanel.(Grid.Row)" Value="0" />
                        <Setter Target="DetailsPanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid x:Name="PageContent" MaxWidth="1080" Padding="20,24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="HeaderSection" Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="小组管理" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="成员可加入多个小组；多人抽取时可对同组剩余成员应用联动倍率。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <CommandBar x:Name="CommandSection" Grid.Row="1" DefaultLabelPosition="Right">
                    <AppBarButton Command="{Binding CreateGroupCommand}" Icon="Add" Label="创建小组" />
                    <AppBarButton Command="{Binding DeleteGroupCommand}" Icon="Delete" Label="删除小组" />
                    <AppBarSeparator />
                    <AppBarButton Command="{Binding ImportCommand}" Icon="OpenFile" Label="导入" />
                    <AppBarButton Command="{Binding ExportCommand}" Icon="SaveLocal" Label="导出" />
                    <AppBarButton Command="{Binding SaveCommandCommand}" Icon="Save" Label="保存" />
                </CommandBar>

                <StackPanel Grid.Row="2" Padding="12,28" Spacing="8" Visibility="{Binding NoGroupsVisibility}">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="还没有小组" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="创建小组后，可添加成员并设置同轮同组成员的概率倍率。"
                        TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Left" Command="{Binding CreateGroupCommand}" Content="创建小组" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <Grid x:Name="EditorSection" Grid.Row="2" ColumnSpacing="20" RowSpacing="20" Visibility="{Binding GroupEditorVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="GroupsColumn" Width="260" />
                        <ColumnDefinition x:Name="DetailsColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="GroupListPanel" Grid.Row="0" Grid.Column="0" Spacing="8">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="小组" />
                        <ListView
                            x:Name="GroupsList"
                            ContainerContentChanging="GroupsList_ContainerContentChanging"
                            ItemsSource="{Binding Groups}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding GroupName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Members.Count}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="DetailsPanel" Grid.Row="0" Grid.Column="1" Spacing="14">
                        <TextBox Header="小组名称" Text="{Binding SelectedGroup.GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="启用后，本轮首次抽中该组成员会提高同组其余成员的概率。"
                            TextWrapping="Wrap" />
                        <ToggleSwitch Header="参与同轮联动" IsOn="{Binding SelectedGroup.IsDrawBoostEnabled, Mode=TwoWay}" OffContent="关闭" OnContent="开启" />
                        <NumberBox
                            Header="同轮同组成员概率倍率"
                            Maximum="10"
                            Minimum="1"
                            SmallChange="0.1"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding SelectedGroup.SameDrawBoostMultiplier, Mode=TwoWay}" />
                        <Button
                            HorizontalAlignment="Left"
                            Click="AddMembers_Click"
                            Content="添加成员"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{Binding HasStatus}"
                            Message="{Binding StatusMessage}"
                            Severity="{Binding StatusSeverity}" />
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="组内成员" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="这个小组还没有成员。"
                            Visibility="{Binding NoGroupMembersVisibility}" />
                        <ListView
                            x:Name="GroupMembersList"
                            ContainerContentChanging="GroupMembersList_ContainerContentChanging"
                            ItemsSource="{Binding SelectedGroup.Members}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="48" Padding="8,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Grid.Column="1"
                                            Padding="8"
                                            AutomationProperties.Name="移出成员"
                                            Click="RemoveMember_Click"
                                            Tag="{Binding}">
                                            <SymbolIcon Symbol="Remove" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
