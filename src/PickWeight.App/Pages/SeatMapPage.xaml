<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.SeatMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <StackPanel x:Name="PageContent" MaxWidth="1100" Padding="20,24" Spacing="16">
                <StackPanel x:Name="HeaderSection" Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="座位表" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="按纵列排布教室座位。每列人数独立，可留过道；点击座位分配成员。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <CommandBar x:Name="CommandSection" DefaultLabelPosition="Right">
                    <AppBarButton Click="AddColumn_Click" Icon="Add" Label="添加列" />
                    <AppBarButton Click="AutoAssign_Click" Icon="Sort" Label="自动排入" />
                    <AppBarButton Click="ClearAll_Click" Icon="ClearSelection" Label="清空座位" />
                    <AppBarSeparator />
                    <AppBarButton Click="Save_Click" Icon="Save" Label="保存" />
                    <AppBarButton Click="Revert_Click" Icon="Undo" Label="撤销修改" />
                </CommandBar>

                <InfoBar
                    x:Name="StatusBar"
                    IsClosable="False"
                    IsOpen="{Binding HasStatus}"
                    Message="{Binding StatusMessage}"
                    Severity="{Binding StatusSeverity}" />

                <StackPanel x:Name="DoorSection" Orientation="Horizontal" Spacing="12">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="靠门侧：" />
                    <RadioButton x:Name="DoorStartRadio" Content="左端" Checked="DoorSide_Checked" Tag="Start" />
                    <RadioButton x:Name="DoorEndRadio" Content="右端" Checked="DoorSide_Checked" Tag="End" />
                </StackPanel>

                <!-- 座位表主体：横向排列的列 -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="SeatGridPanel" Orientation="Horizontal" Spacing="0" Padding="0,8,0,8" />
                </ScrollViewer>

                <StackPanel x:Name="UnassignedSection" Spacing="6">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="未分配成员" />
                    <ItemsControl x:Name="UnassignedList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid MaximumRowsOrColumns="10" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,6,6"
                                    Padding="10,6"
                                    Click="UnassignedMember_Click"
                                    Tag="{Binding}">
                                    <TextBlock Text="{Binding}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="点击未分配成员，再点击空座位完成分配。"
                        Visibility="{Binding HasUnassignedVisibility}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 成员选择对话框 -->
        <ContentDialog
            x:Name="MemberPickerDialog"
            CloseButtonText="取消"
            PrimaryButtonText="确定"
            Title="选择成员">
            <StackPanel MinWidth="320" Spacing="10">
                <TextBox x:Name="MemberSearchBox" PlaceholderText="搜索姓名" TextChanged="MemberSearchBox_TextChanged" />
                <ListView x:Name="MemberPickerList" MaxHeight="300" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
