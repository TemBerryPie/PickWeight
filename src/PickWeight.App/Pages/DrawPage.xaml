<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.DrawPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="PageRoot"
    mc:Ignorable="d">
    <Grid KeyDown="PageRoot_KeyDown">
        <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid MaxWidth="1000" Padding="20,24" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="HeaderSection" Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="开始点名" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding CandidateSummary}" TextWrapping="Wrap" />
                    <Grid
                        ColumnSpacing="10"
                        Visibility="{Binding RoundProgressVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="RoundProgressLabel"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding RoundProgressText}" />
                        <ProgressBar
                            Grid.Column="1"
                            Height="6"
                            VerticalAlignment="Center"
                            Maximum="100"
                            Value="{Binding RoundProgressValue}" />
                        <Button
                            Grid.Column="2"
                            Padding="10,4"
                            Command="{Binding StartNextRoundCommand}"
                            Content="重开一轮"
                            FontSize="12" />
                    </Grid>
                </StackPanel>

                <Expander
                    x:Name="AttendanceSection"
                    Grid.Row="1"
                    Header="{Binding AttendanceSummary}"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <StackPanel Padding="0,10,0,0" Spacing="8">
                        <ItemsControl ItemsSource="{Binding AttendanceMembers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid MaximumRowsOrColumns="8" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        MinWidth="56"
                                        Margin="0,0,6,6"
                                        Padding="10,6"
                                        AutomationProperties.Name="切换请假状态"
                                        Content="{Binding Name}"
                                        IsChecked="{Binding IsAbsent, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            HorizontalAlignment="Left"
                            Command="{Binding MarkAllPresentCommand}"
                            Content="全部到齐"
                            FontSize="12" />
                    </StackPanel>
                </Expander>

                <StackPanel x:Name="ActionSection" Grid.Row="2" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="220" DisplayMemberPath="Name" ItemsSource="{Binding DrawPresets}" PlaceholderText="选择抽取预设" SelectedItem="{Binding SelectedDrawPreset, Mode=TwoWay}" />
                        <Button Click="ApplyPreset_Click" Content="应用预设" />
                        <Button Click="SavePreset_Click" Content="保存为预设" />
                        <Button Click="DeletePreset_Click" Content="删除预设" />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{Binding DrawCommand}"
                        Content="开始抽取"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="ViewSeatMap_Click"
                        Content="查看所在座位"
                        IsEnabled="{Binding HasSelectedResults}"
                        Visibility="{Binding HasSeatMapVisibility}" />
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="8">
                        <Button Click="RulesButton_Click" Content="规则和概率" />
                        <Button Command="{Binding DiscardCurrentDrawCommand}" Content="丢弃本次" />
                    </StackPanel>
                </StackPanel>

                <InfoBar
                    x:Name="FairnessReminderSection"
                    Grid.Row="3"
                    CloseButtonClick="FairnessReminder_CloseButtonClick"
                    IsClosable="True"
                    IsOpen="{Binding HasFairnessReminder}"
                    Message="{Binding FairnessReminderText}"
                    Severity="Informational"
                    Title="公平性提醒（关闭 = 忽略）">
                    <InfoBar.ActionButton>
                        <Button Command="{Binding BoostForThisDrawCommand}" Content="本次优先" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    x:Name="StatusSection"
                    Grid.Row="4"
                    IsClosable="False"
                    IsOpen="{Binding HasStatus}"
                    Message="{Binding StatusMessage}"
                    Severity="Informational" />

                <Grid Grid.Row="5" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="本次结果" />
                    <TextBlock
                        Grid.Row="1"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="快捷键：空格 抽取 · 1-4 切换模式 · +/- 人数 · R 换一个" />
                    <ListView
                        x:Name="ResultsList"
                        Grid.Row="2"
                        ContainerContentChanging="ResultsList_ContainerContentChanging"
                        ItemsSource="{Binding Results}"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,4"
                                    Padding="14,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding CommitCommand}"
                                            Padding="2">
                                            <StackPanel Spacing="3">
                                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding WeightText}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding StateText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                        <Grid Grid.Column="1" VerticalAlignment="Center" RowSpacing="8" ColumnSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Width="44"
                                                Height="44"
                                                Command="{Binding ReplaceCommand}"
                                                ToolTipService.ToolTip="换一个（重抽一人替换）">
                                                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                            </Button>
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Width="44"
                                                Height="44"
                                                Command="{Binding DiscardCommand}"
                                                ToolTipService.ToolTip="丢弃此结果">
                                                <SymbolIcon Symbol="Delete" />
                                            </Button>
                                            <Button
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Width="44"
                                                Height="44"
                                                Command="{Binding RateGoodCommand}"
                                                ToolTipService.ToolTip="良好">
                                                <FontIcon FontSize="18" Glyph="&#xE19F;" />
                                            </Button>
                                            <Button
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Width="44"
                                                Height="44"
                                                Command="{Binding RateFairCommand}"
                                                ToolTipService.ToolTip="一般">
                                                <FontIcon FontSize="18" Glyph="&#xE73E;" />
                                            </Button>
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding RatingText}"
                                                Visibility="{Binding HasRating}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </ScrollViewer>

        <ContentDialog
            x:Name="RulesDialog"
            DefaultButton="Primary"
            Opened="RulesDialog_Opened"
            PrimaryButtonClick="RulesDialog_PrimaryButtonClick"
            PrimaryButtonText="确定"
            SecondaryButtonClick="RulesDialog_SecondaryButtonClick"
            SecondaryButtonText="取消"
            Title="规则和概率">
            <ScrollViewer
                MaxHeight="620"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
                <TabView IsAddTabButtonVisible="False">
                    <TabViewItem Header="规则" IsClosable="False">
                        <StackPanel Padding="0,14,0,0" Spacing="14">
                            <ComboBox Header="点名模式" SelectedIndex="{Binding SelectedDrawModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="加权模式" />
                                <ComboBoxItem Content="智能随机" />
                                <ComboBoxItem Content="完全随机" />
                                <ComboBoxItem Content="选择模式" />
                            </ComboBox>
                            <NumberBox Header="抽取人数" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding TargetCount, Mode=TwoWay}" />
                            <ComboBox Header="只抽小组" ItemsSource="{Binding GroupFilterOptions}" SelectedIndex="{Binding IncludeGroupFilterIndex, Mode=TwoWay}" />
                            <ComboBox Header="排除小组" ItemsSource="{Binding GroupFilterOptions}" SelectedIndex="{Binding ExcludeGroupFilterIndex, Mode=TwoWay}" />
                            <NumberBox Header="排除最近抽取记录数" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding ExcludeRecentDrawCount, Mode=TwoWay}" />
                            <ToggleSwitch Header="只抽从未出现在历史中的成员" IsOn="{Binding OnlyNeverDrawn, Mode=TwoWay}" />
                            <ToggleSwitch
                                Header="一轮不重复（本轮已点成员不再抽取）"
                                IsOn="{Binding NoRepeatInRound, Mode=TwoWay}"
                                OffContent="关闭"
                                OnContent="开启" />
                            <ComboBox Header="按座位范围" ItemsSource="{Binding SeatRegionOptions}" SelectedIndex="{Binding SelectedSeatRegionIndex, Mode=TwoWay}" />
                            <NumberBox
                                Header="指定列（1 起，靠门侧为 1）"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding SeatColumnNumber, Mode=TwoWay}"
                                Visibility="{Binding SeatColumnVisibility}" />
                            <NumberBox
                                Header="指定排（1 起，每列独立计数）"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding SeatRowNumber, Mode=TwoWay}"
                                Visibility="{Binding SeatRowVisibility}" />
                        </StackPanel>
                    </TabViewItem>
                    <TabViewItem Header="人员概率概览" IsClosable="False">
                        <Grid Padding="0,14,0,0">
                            <StackPanel Spacing="8" Visibility="{Binding EmptyProbabilityPreviewVisibility}">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="无可抽取候选" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="请调整规则、小组或历史筛选条件。" TextWrapping="Wrap" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ProbabilityPreview}" Visibility="{Binding ProbabilityPreviewVisibility}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="58" Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="86" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding FactorsText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding ProbabilityText}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem Header="本次规则摘要" IsClosable="False">
                        <ItemsControl Padding="0,14,0,0" ItemsSource="{Binding RuleSummaryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Value}" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabViewItem>
                </TabView>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
