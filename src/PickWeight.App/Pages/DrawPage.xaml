<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.DrawPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="PageRoot"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid MaxWidth="1000" Padding="20,24" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="HeaderSection" Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="开始点名" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding CandidateSummary}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="ActionSection" Grid.Row="1" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="220" DisplayMemberPath="Name" ItemsSource="{Binding DrawPresets}" PlaceholderText="选择抽取预设" SelectedItem="{Binding SelectedDrawPreset, Mode=TwoWay}" />
                        <Button Click="ApplyPreset_Click" Content="应用预设" />
                        <Button Click="SavePreset_Click" Content="保存为预设" />
                        <Button Click="DeletePreset_Click" Content="删除预设" />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{Binding DrawCommand}"
                        Content="开始抽取"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="8">
                        <Button Click="RulesButton_Click" Content="规则和概率" />
                        <Button Click="PresentationDraw_Click" Content="投影抽取" />
                        <Button Command="{Binding DiscardCurrentDrawCommand}" Content="丢弃本次" />
                    </StackPanel>
                </StackPanel>

                <InfoBar
                    x:Name="StatusSection"
                    Grid.Row="2"
                    IsClosable="False"
                    IsOpen="{Binding HasStatus}"
                    Message="{Binding StatusMessage}"
                    Severity="Informational" />

                <Grid Grid.Row="3" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="本次结果" />
                    <ListView
                        x:Name="ResultsList"
                        Grid.Row="1"
                        ContainerContentChanging="ResultsList_ContainerContentChanging"
                        ItemsSource="{Binding Results}"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,4"
                                    Padding="14,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding CommitCommand}"
                                            Padding="2">
                                            <StackPanel Spacing="3">
                                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding WeightText}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding StateText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            Width="44"
                                            Height="44"
                                            VerticalAlignment="Center"
                                            Command="{Binding DiscardCommand}"
                                            ToolTipService.ToolTip="丢弃此结果">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </ScrollViewer>

        <ContentDialog
            x:Name="RulesDialog"
            DefaultButton="Primary"
            Opened="RulesDialog_Opened"
            PrimaryButtonClick="RulesDialog_PrimaryButtonClick"
            PrimaryButtonText="确定"
            SecondaryButtonClick="RulesDialog_SecondaryButtonClick"
            SecondaryButtonText="取消"
            Title="规则和概率">
            <ScrollViewer
                MaxHeight="620"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
                <TabView IsAddTabButtonVisible="False">
                    <TabViewItem Header="规则" IsClosable="False">
                        <StackPanel Padding="0,14,0,0" Spacing="14">
                            <ComboBox Header="点名模式" SelectedIndex="{Binding SelectedDrawModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="加权模式" />
                                <ComboBoxItem Content="智能随机" />
                                <ComboBoxItem Content="完全随机" />
                                <ComboBoxItem Content="选择模式" />
                            </ComboBox>
                            <NumberBox Header="抽取人数" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding TargetCount, Mode=TwoWay}" />
                            <ComboBox Header="只抽小组" ItemsSource="{Binding GroupFilterOptions}" SelectedIndex="{Binding IncludeGroupFilterIndex, Mode=TwoWay}" />
                            <ComboBox Header="排除小组" ItemsSource="{Binding GroupFilterOptions}" SelectedIndex="{Binding ExcludeGroupFilterIndex, Mode=TwoWay}" />
                            <NumberBox Header="排除最近抽取记录数" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding ExcludeRecentDrawCount, Mode=TwoWay}" />
                            <ToggleSwitch Header="只抽从未出现在历史中的成员" IsOn="{Binding OnlyNeverDrawn, Mode=TwoWay}" />
                        </StackPanel>
                    </TabViewItem>
                    <TabViewItem Header="人员概率概览" IsClosable="False">
                        <Grid Padding="0,14,0,0">
                            <StackPanel Spacing="8" Visibility="{Binding EmptyProbabilityPreviewVisibility}">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="无可抽取候选" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="请调整规则、小组或历史筛选条件。" TextWrapping="Wrap" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ProbabilityPreview}" Visibility="{Binding ProbabilityPreviewVisibility}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="58" Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="86" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding FactorsText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding ProbabilityText}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem Header="本次规则摘要" IsClosable="False">
                        <ItemsControl Padding="0,14,0,0" ItemsSource="{Binding RuleSummaryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Value}" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabViewItem>
                </TabView>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
