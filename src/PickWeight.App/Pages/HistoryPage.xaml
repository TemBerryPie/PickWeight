<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="12,16,12,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="20,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="PageContent" HorizontalAlignment="Stretch" MaxWidth="1000" Padding="20,24" Spacing="16">
                <StackPanel x:Name="HeaderSection" Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="统计分析" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="查看抽取趋势、成员覆盖情况、小组分布和完整历史记录。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <CommandBar x:Name="CommandSection" DefaultLabelPosition="Right">
                    <AppBarButton Command="{Binding ExportCsvCommand}" Icon="SaveLocal" Label="导出 CSV" />
                    <AppBarButton Command="{Binding ExportJsonCommand}" Icon="Save" Label="导出 JSON" />
                    <AppBarButton Command="{Binding ClearFiltersCommand}" Icon="Filter" Label="清除筛选" />
                    <AppBarButton Command="{Binding ClearHistoryCommand}" Icon="Delete" Label="清除历史" />
                </CommandBar>

                <StackPanel x:Name="SummarySection" Spacing="8">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="概览" />
                    <ItemsControl ItemsSource="{Binding OverviewStatistics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" MinWidth="170">
                                    <StackPanel Spacing="4">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Title}" />
                                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Value}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Grid x:Name="AnalysisSection" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="成员排行" />
                        <ListView ItemsSource="{Binding TopMemberStatistics}" MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding PercentageText}" /></StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding DrawCount}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="ShowAllMembers_Click" Content="查看全部成员" />
                            <Button Click="ShowNeverDrawn_Click" Content="查看未抽取成员" />
                        </StackPanel>
                        <StackPanel Spacing="4" Visibility="{Binding StaleMembersVisibility}">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="长期未被点提醒" />
                            <ItemsControl ItemsSource="{Binding StaleMembers}">
                                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Padding="0,4"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="小组统计" />
                        <ListView ItemsSource="{Binding GroupStatistics}" MaxHeight="320" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2"><TextBlock FontWeight="SemiBold" Text="{Binding GroupName}" /><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="成员" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding MemberCount}" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="· 平均" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding AverageDrawCountText}" /></StackPanel></StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding DrawCount}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="TrendSection" Spacing="8">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="最近 30 天趋势" />
                    <ItemsControl ItemsSource="{Binding DailyTrendStatistics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Date}" />
                                    <ProgressBar Grid.Column="1" Height="8" Maximum="100" Value="{Binding BarWidth}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding DrawCount}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Expander x:Name="FilterSection" Header="筛选与范围" IsExpanded="False">
                    <Grid Padding="0,12,0,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CalendarDatePicker MinWidth="150" Header="开始日期" Date="{Binding StartDate, Mode=TwoWay}" />
                        <CalendarDatePicker Grid.Column="1" MinWidth="150" Header="结束日期" Date="{Binding EndDate, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2" MinWidth="150" Header="成员" ItemsSource="{Binding MemberFilterOptions}" SelectedIndex="{Binding SelectedMemberFilterIndex, Mode=TwoWay}" />
                        <ComboBox Grid.Column="3" MinWidth="150" Header="小组" ItemsSource="{Binding GroupFilterOptions}" SelectedIndex="{Binding SelectedGroupFilterIndex, Mode=TwoWay}" />
                    </Grid>
                </Expander>

                <InfoBar
                    x:Name="StatusSection"
                    IsClosable="False"
                    IsOpen="{Binding HasStatus}"
                    Message="{Binding StatusMessage}"
                    Severity="{Binding StatusSeverity}" />

                <StackPanel x:Name="HistoryContentSection" Spacing="18">
                    <StackPanel Padding="12,28" Spacing="8" Visibility="{Binding EmptyStateVisibility}">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding EmptyStateTitle}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding EmptyStateDescription}" TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Left"
                            Command="{Binding ClearFiltersCommand}"
                            Content="清除筛选"
                            Visibility="{Binding ClearEmptyFiltersVisibility}" />
                    </StackPanel>

                    <StackPanel Spacing="18" Visibility="{Binding HistoryListVisibility}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="抽取记录" />
                            <ListView
                                x:Name="HistoryList"
                                ContainerContentChanging="HistoryList_ContainerContentChanging"
                                ItemsSource="{Binding History}"
                                MaxHeight="360"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollMode="Enabled"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel MinHeight="56" Padding="10,8" Spacing="4">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding DrawnAt}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding MemberNames}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="8" Visibility="Collapsed">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="成员排行" />
                            <ListView
                                x:Name="MemberStatisticsList"
                                ContainerContentChanging="StatisticsList_ContainerContentChanging"
                                ItemsSource="{Binding MemberStatistics}"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding DrawCount}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="8" Visibility="Collapsed">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="小组统计" />
                            <ListView
                                x:Name="GroupStatisticsList"
                                ContainerContentChanging="StatisticsList_ContainerContentChanging"
                                ItemsSource="{Binding GroupStatistics}"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding GroupName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding MemberCount}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding DrawCount}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="8" Visibility="Collapsed">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="从未被点" />
                            <ListView
                                x:Name="NeverDrawnMembersList"
                                ContainerContentChanging="StatisticsList_ContainerContentChanging"
                                ItemsSource="{Binding NeverDrawnMembers}"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
