<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.MembersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ViewModels="using:PickWeight_App.ViewModels"
    mc:Ignorable="d">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="12,16,12,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="20,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid x:Name="PageContent" MaxWidth="940" Padding="20,24" HorizontalAlignment="Stretch" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="HeaderSection" Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="成员管理" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="成员列表保持轻量，仅显示姓名、被点热度和启用开关；点击编辑图标维护资料、权重和被点次数。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <CommandBar x:Name="CommandSection" Grid.Row="1" DefaultLabelPosition="Right">
                    <AppBarButton Click="AddMember_Click" Icon="Add" Label="新增成员" />
                    <AppBarButton Command="{Binding ImportCommand}" Icon="OpenFile" Label="导入名单" />
                    <AppBarButton Command="{Binding ImportExcelCommand}" Icon="OpenFile" Label="导入 Excel" />
                    <AppBarButton Click="PasteImport_Click" Icon="Paste" Label="粘贴导入" />
                    <AppBarButton Command="{Binding ExportCommand}" Icon="SaveLocal" Label="导出" />
                    <AppBarSeparator />
                    <AppBarButton Click="EnableSelected_Click" Icon="Accept" Label="启用所选" />
                    <AppBarButton Click="DisableSelected_Click" Icon="BlockContact" Label="停用所选" />
                    <AppBarButton Click="SetWeightSelected_Click" Icon="Edit" Label="设置权重" />
                    <AppBarButton Click="Undo_Click" Icon="Undo" Label="撤销" />
                    <AppBarButton Click="Redo_Click" Icon="Redo" Label="重做" />
                    <AppBarButton Click="DeleteSelected_Click" Icon="Delete" Label="删除所选" />
                    <AppBarButton Command="{Binding ResetCommand}" Icon="Refresh" Label="重置成员数据" />
                </CommandBar>

                <Grid x:Name="SearchSection" Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        MinWidth="140"
                        Header="排序"
                        ItemsSource="{x:Bind ViewModels:MembersPageViewModel.SortOptions, Mode=OneWay}"
                        SelectedIndex="{Binding SortOptionIndex, Mode=TwoWay}" />
                    <TextBox
                        Grid.Column="1"
                        Header="搜索姓名"
                        PlaceholderText="输入姓名关键字"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid x:Name="ListSection" Grid.Row="3" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="{Binding HasStatus}"
                        Message="{Binding StatusMessage}"
                        Severity="{Binding StatusSeverity}" />

                    <StackPanel
                        Grid.Row="1"
                        Padding="12,28"
                        Spacing="8"
                        Visibility="{Binding EmptyStateVisibility}">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding EmptyStateTitle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding EmptyStateDescription}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="AddMember_Click" Content="新增成员" Style="{ThemeResource AccentButtonStyle}" />
                            <Button Command="{Binding ImportCommand}" Content="导入名单" />
                        </StackPanel>
                    </StackPanel>

                    <ListView
                        x:Name="MembersList"
                        Grid.Row="1"
                        ContainerContentChanging="MembersList_ContainerContentChanging"
                        ItemsSource="{Binding FilteredMembers}"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                        SelectionMode="Extended"
                        Visibility="{Binding MembersListVisibility}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="68" Padding="8,6" ColumnSpacing="12" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.RowSpan="2"
                                        Padding="8"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="编辑成员"
                                        Click="EditMember_Click"
                                        Tag="{Binding}">
                                        <SymbolIcon Symbol="Edit" />
                                    </Button>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <ProgressBar
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{Binding HeatBarValue, Mode=OneWay}" />
                                    <ToggleSwitch
                                        Grid.RowSpan="2"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="启用成员"
                                        IsOn="{Binding IsActive, Mode=TwoWay}"
                                        OffContent="停用"
                                        OnContent="启用" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

