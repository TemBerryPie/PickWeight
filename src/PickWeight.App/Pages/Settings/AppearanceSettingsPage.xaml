<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.Settings.AppearanceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" Spacing="12">
            <Button
                AutomationProperties.Name="返回设置"
                Background="Transparent"
                Click="BackButton_Click"
                Padding="10"
                ToolTipService.ToolTip="返回">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="外观和个性化" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="主题、背景效果、模糊和动画调节" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <StackPanel x:Name="ContentPanel" MaxWidth="860" Spacing="16">
                <ComboBox Header="界面主题" SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="深色" />
                </ComboBox>
                <ComboBox Header="背景效果" SelectedIndex="{Binding SelectedBackgroundEffectIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="亚克力 Acrylic" />
                    <ComboBoxItem Content="云母 Mica" />
                </ComboBox>
                <Slider Header="Acrylic 背景强度" IsEnabled="{Binding IsAcrylicSelected}" Maximum="1" Minimum="0" SmallChange="0.01" StepFrequency="0.01" Value="{Binding AcrylicBlurAmount, Mode=TwoWay}" />
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="动画" />
                <Slider Header="动画速度" Maximum="2" Minimum="0.5" SmallChange="0.1" StepFrequency="0.1" Value="{Binding AnimationSpeed, Mode=TwoWay}" />
                <Slider Header="动画运动幅度" Maximum="2" Minimum="0" SmallChange="0.1" StepFrequency="0.1" Value="{Binding AnimationMotionScale, Mode=TwoWay}" />
                <Slider Header="动画回弹幅度" Maximum="2" Minimum="0" SmallChange="0.1" StepFrequency="0.1" Value="{Binding AnimationBounceScale, Mode=TwoWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="默认值均为 1.0；将运动或回弹幅度设为 0 可关闭对应效果。" TextWrapping="Wrap" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding RestoreDefaultsCommand}" Content="恢复默认" />
                    <Button Grid.Column="1" Command="{Binding PreviewAnimationCommand}" Content="预览动画" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
