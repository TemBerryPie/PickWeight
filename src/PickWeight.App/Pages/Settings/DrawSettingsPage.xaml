<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.Settings.DrawSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" Spacing="12">
            <Button
                AutomationProperties.Name="返回设置"
                Background="Transparent"
                Click="BackButton_Click"
                Padding="10"
                ToolTipService.ToolTip="返回">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="点名设置" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="默认点名模式、自动重置设置" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <StackPanel x:Name="ContentPanel" MaxWidth="860" Spacing="16">
                <ComboBox Header="默认点名模式" SelectedIndex="{Binding SelectedDrawModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="加权模式" />
                    <ComboBoxItem Content="智能随机" />
                    <ComboBoxItem Content="完全随机" />
                    <ComboBoxItem Content="选择模式" />
                </ComboBox>
                <ToggleSwitch Header="自动重置" IsOn="{Binding AutoResetWeights, Mode=TwoWay}" OffContent="关闭" OnContent="开启" />
                <NumberBox Header="抽取多少次后自动重置" IsEnabled="{Binding IsAutoResetIntervalEnabled}" Maximum="10000" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding AutoResetDrawInterval, Mode=TwoWay}" />
                <NumberBox Header="长期未被点提醒（天）" Maximum="365" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding FairnessReminderDays, Mode=TwoWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
