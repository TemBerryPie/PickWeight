<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.Settings.RatingSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" Spacing="12">
            <Button
                AutomationProperties.Name="返回设置"
                Background="Transparent"
                Click="BackButton_Click"
                Padding="10"
                ToolTipService.ToolTip="返回">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="评价与权重" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="课堂表现评价对权重的影响" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <StackPanel x:Name="ContentPanel" MaxWidth="860" Spacing="16">
                <ToggleSwitch Header="评价影响权重" IsOn="{Binding RatingAffectsWeight, Mode=TwoWay}" OffContent="关闭" OnContent="开启" />
                <NumberBox Header="良好权重倍率" Value="{Binding RatingWeightMultiplier, Mode=TwoWay}" Minimum="0.1" Maximum="1.0" SmallChange="0.1" SpinButtonPlacementMode="Inline" />
                <NumberBox Header="一般权重倍率" Value="{Binding RatingFairMultiplier, Mode=TwoWay}" Minimum="0.1" Maximum="1.0" SmallChange="0.1" SpinButtonPlacementMode="Inline" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="开启后，评价「良好」按良好权重倍率降低权重，评价「一般」按一般权重倍率降低权重。" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
