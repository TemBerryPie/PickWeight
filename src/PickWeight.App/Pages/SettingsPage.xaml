<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="SettingsCategoryButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Padding" Value="12,16,12,24" />
                        <Setter Target="SettingsContent.MaxWidth" Value="760" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Padding" Value="24" />
                        <Setter Target="SettingsContent.MaxWidth" Value="860" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <StackPanel
                x:Name="SettingsContent"
                HorizontalAlignment="Stretch"
                MaxWidth="860"
                Padding="24"
                Spacing="16">
                <StackPanel x:Name="HeaderSection" Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="设置" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="选择一个分类进行设置，所有更改都会自动保存。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid x:Name="StatusSection" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{Binding HasStatus}"
                        Message="{Binding StatusMessage}"
                        Severity="{Binding StatusSeverity}" />
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding AutoSaveStateText}" />
                </Grid>

                <StackPanel x:Name="CategoryList" Spacing="8">
                    <Button
                        x:Name="SystemCategoryCard"
                        AutomationProperties.Name="打开系统设置"
                        Click="SystemCategoryCard_Click"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="28" Glyph="&#xE770;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="系统设置" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="开机自启动、快捷启动功能" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="DrawCategoryCard"
                        AutomationProperties.Name="打开点名设置"
                        Click="DrawCategoryCard_Click"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="28" Glyph="&#xE77B;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="点名设置" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="默认点名模式、自动重置设置" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="NotificationCategoryCard"
                        AutomationProperties.Name="打开通知设置"
                        Click="NotificationCategoryCard_Click"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="28" Glyph="&#xEA8F;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="通知" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="抽取结果通知、ClassIsland 提醒" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="AppearanceCategoryCard"
                        AutomationProperties.Name="打开外观和个性化设置"
                        Click="AppearanceCategoryCard_Click"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="28" Glyph="&#xE771;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="外观和个性化" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="主题、背景效果、模糊和动画调节" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog x:Name="SystemSettingsDialog" CloseButtonText="关闭" Opened="SettingsDialog_Opened" Title="系统设置">
            <StackPanel x:Name="SystemSettingsSection" Spacing="16">
                <ToggleSwitch Header="开机自启" IsOn="{Binding StartWithWindows, Mode=TwoWay}" OffContent="关闭" OnContent="开启" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="程序将在登录 Windows 后自动运行。" TextWrapping="Wrap" />
                <ToggleSwitch Header="快捷启动功能" IsOn="{Binding ShowQuickDrawButton, Mode=TwoWay}" OffContent="关闭" OnContent="开启" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="启用后显示可拖动的快捷启动小窗。" TextWrapping="Wrap" />
                <TextBox Header="全局快捷键" PlaceholderText="Ctrl+Alt+P" Text="{Binding GlobalHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="仅支持 Ctrl+Alt+字母，例如 Ctrl+Alt+P；主窗口隐藏时也可触发快速抽取。" TextWrapping="Wrap" />
                <Button Click="FirstRunWizard_Click" Content="重新运行首次运行引导" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="重新配置成员和点名规则，不会删除现有数据。" TextWrapping="Wrap" />
                <Button Click="ShowLocalApiToken_Click" Content="查看本地 API 令牌" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="本地 API 仅监听 127.0.0.1:17861，外部脚本需在 X-PickWeight-Token 请求头中携带令牌。" TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="DrawSettingsDialog" CloseButtonText="关闭" Opened="SettingsDialog_Opened" Title="点名设置">
            <StackPanel x:Name="DrawSettingsSection" Spacing="16">
                <ComboBox Header="默认点名模式" SelectedIndex="{Binding SelectedDrawModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="加权模式" />
                    <ComboBoxItem Content="智能随机" />
                    <ComboBoxItem Content="完全随机" />
                    <ComboBoxItem Content="选择模式" />
                </ComboBox>
                <ToggleSwitch Header="自动重置" IsOn="{Binding AutoResetWeights, Mode=TwoWay}" OffContent="关闭" OnContent="开启" />
                <NumberBox Header="抽取多少次后自动重置" IsEnabled="{Binding IsAutoResetIntervalEnabled}" Maximum="10000" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding AutoResetDrawInterval, Mode=TwoWay}" />
                <NumberBox Header="长期未被点提醒（天）" Maximum="365" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding FairnessReminderDays, Mode=TwoWay}" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="NotificationSettingsDialog" CloseButtonText="关闭" Opened="SettingsDialog_Opened" Title="通知">
            <StackPanel x:Name="NotificationSettingsSection" Spacing="16">
                <ToggleSwitch Header="抽取结果通知" IsOn="{Binding ShowDrawNotifications, Mode=TwoWay}" OffContent="关闭" OnContent="开启" />
                <ToggleSwitch Header="ClassIsland 抽取提醒" IsOn="{Binding ShowClassIslandNotifications, Mode=TwoWay}" OffContent="关闭" OnContent="开启" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ClassIsland 未连接时，点名结果仍会正常保存。" TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="AppearanceSettingsDialog" CloseButtonText="关闭" Opened="SettingsDialog_Opened" Title="外观和个性化">
            <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="AppearanceSettingsSection" Spacing="16">
                    <ComboBox Header="界面主题" SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>
                    <ComboBox Header="背景效果" SelectedIndex="{Binding SelectedBackgroundEffectIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="亚克力 Acrylic" />
                        <ComboBoxItem Content="云母 Mica" />
                    </ComboBox>
                    <Slider Header="Acrylic 背景强度" IsEnabled="{Binding IsAcrylicSelected}" Maximum="1" Minimum="0" SmallChange="0.01" StepFrequency="0.01" Value="{Binding AcrylicBlurAmount, Mode=TwoWay}" />
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="动画" />
                    <Slider Header="动画速度" Maximum="2" Minimum="0.5" SmallChange="0.1" StepFrequency="0.1" Value="{Binding AnimationSpeed, Mode=TwoWay}" />
                    <Slider Header="动画运动幅度" Maximum="2" Minimum="0" SmallChange="0.1" StepFrequency="0.1" Value="{Binding AnimationMotionScale, Mode=TwoWay}" />
                    <Slider Header="动画回弹幅度" Maximum="2" Minimum="0" SmallChange="0.1" StepFrequency="0.1" Value="{Binding AnimationBounceScale, Mode=TwoWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="默认值均为 1.0；将运动或回弹幅度设为 0 可关闭对应效果。" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding RestoreDefaultsCommand}" Content="恢复默认" />
                        <Button Grid.Column="1" Command="{Binding PreviewAnimationCommand}" Content="预览动画" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
