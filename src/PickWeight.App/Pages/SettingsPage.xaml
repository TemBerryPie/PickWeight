<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="SettingsCategoryButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Padding" Value="12,16,12,24" />
                        <Setter Target="SettingsContent.MaxWidth" Value="760" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Padding" Value="24" />
                        <Setter Target="SettingsContent.MaxWidth" Value="860" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            x:Name="SettingsListScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <StackPanel
                x:Name="SettingsContent"
                HorizontalAlignment="Stretch"
                MaxWidth="860"
                Padding="24"
                Spacing="16">
                <StackPanel x:Name="HeaderSection" Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="设置" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="选择一个分类进行设置，所有更改都会自动保存。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid x:Name="StatusSection" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{Binding HasStatus}"
                        Message="{Binding StatusMessage}"
                        Severity="{Binding StatusSeverity}" />
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding AutoSaveStateText}" />
                </Grid>

                <StackPanel x:Name="CategoryList" Spacing="8">
                    <Button
                        x:Name="SystemCategoryCard"
                        AutomationProperties.Name="打开系统设置"
                        Click="SystemCategoryCard_Click"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="28" Glyph="&#xE770;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="系统设置" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="开机自启动、快捷启动功能" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="DrawCategoryCard"
                        AutomationProperties.Name="打开点名设置"
                        Click="DrawCategoryCard_Click"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="28" Glyph="&#xE77B;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="点名设置" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="默认点名模式、自动重置设置" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="RatingCategoryCard"
                        AutomationProperties.Name="打开评价与权重设置"
                        Click="RatingCategoryCard_Click"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="28" Glyph="&#xE735;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="评价与权重" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="课堂表现评价对权重的影响" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="HistoryArchiveCategoryCard"
                        AutomationProperties.Name="打开历史与归档设置"
                        Click="HistoryArchiveCategoryCard_Click"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="28" Glyph="&#xE81C;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="历史与归档" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="历史保留天数、归档数据统计" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="NotificationCategoryCard"
                        AutomationProperties.Name="打开通知设置"
                        Click="NotificationCategoryCard_Click"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="28" Glyph="&#xEA8F;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="通知" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="抽取结果通知、ClassIsland 提醒" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="AppearanceCategoryCard"
                        AutomationProperties.Name="打开外观和个性化设置"
                        Click="AppearanceCategoryCard_Click"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="28" Glyph="&#xE771;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="外观和个性化" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="主题、背景效果、模糊和动画调节" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Frame
            x:Name="SettingsFrame"
            HorizontalAlignment="Stretch"
            Navigated="SettingsFrame_Navigated"
            VerticalAlignment="Stretch"
            Visibility="Collapsed" />
    </Grid>
</Page>
