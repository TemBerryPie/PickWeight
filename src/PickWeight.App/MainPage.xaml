<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="Navigation"
        Background="Transparent"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        CompactPaneLength="56"
        OpenPaneLength="280"
        PaneDisplayMode="Left"
        SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="开始点名" Icon="Play" Tag="draw" />
            <NavigationViewItem Content="统计分析" Icon="Clock" Tag="history" />
            <NavigationViewItem Content="权重编辑器" Icon="Contact" Tag="members" />
            <NavigationViewItem Content="小组绑定器" Icon="People" Tag="groups" />
            <NavigationViewItem Content="座位表" Icon="ViewAll" Tag="seats" />
        </NavigationView.MenuItems>
        <NavigationView.PaneCustomContent>
            <StackPanel Padding="4,8" Spacing="4">
                <TextBlock
                    x:Name="ClassroomLabel"
                    Margin="12,0"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="当前班级"
                    Visibility="Collapsed" />
                <DropDownButton
                    x:Name="ClassroomSwitcher"
                    Margin="4,0"
                    AutomationProperties.Name="切换班级"
                    Click="ClassroomSwitcher_Click">
                    <DropDownButton.Flyout>
                        <MenuFlyout />
                    </DropDownButton.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE716;" />
                        <TextBlock x:Name="ClassroomNameText" Text="班级" />
                    </StackPanel>
                </DropDownButton>
            </StackPanel>
        </NavigationView.PaneCustomContent>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
