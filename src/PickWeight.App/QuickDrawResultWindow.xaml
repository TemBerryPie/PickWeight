<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PickWeight_App.QuickDrawResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="快速抽取">
    <Border
        x:Name="WindowRoot"
        Background="Transparent"
        Padding="28,20"
        AutomationProperties.Name="快速抽取结果"
        CornerRadius="20"
        Loaded="WindowRoot_Loaded"
        KeyDown="WindowRoot_KeyDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 单人：巨大居中的名字 -->
            <TextBlock
                x:Name="NameText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="抽取结果姓名"
                FontSize="44"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                IsTextSelectionEnabled="False"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <!-- 多人：横排或网格的名字列表，逐个揭晓 -->
            <ItemsControl
                x:Name="NamesList"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="多人抽取结果"
                Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="False" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </ItemsControl.ItemContainerTransitions>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="8"
                            Padding="20,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="40"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
